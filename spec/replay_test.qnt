    ev("connended").with("gen", 2),
    ev("sessionclosed").with("session", 1),
  ]
  run unsentRanTest = replayInit.then((3 * UNSENT_RAN.length()).reps(i => replayStep(UNSENT_RAN))).expect(replayed(UNSENT_RAN))
}
