    ev("finished").with("gen", 2).with("stream", 12).with("errno", false),
    ev("answered").with("origin", "call").with("call", 4).with("gen", 2).with("stream", 12).with("errno", false),
    ev("connended").with("gen", 2),
    ev("sessionclosed").with("session", 1),
  ]
  run resendOvertakesTest = replayInit.then((3 * RESEND_OVERTAKES.length()).reps(i => replayStep(RESEND_OVERTAKES))).expect(replayed(RESEND_OVERTAKES))

  /// The client takes a frame it wrote for one never sent, which would let it send the change again, and the server runs it.
  pure val UNSENT_RAN: List[Ev] = [
    ev("created").with("session", 1),
    ev("attached").with("session", 1).with("epoch", 1).with("gen", 1),
    ev("connected").with("gen", 1).with("session", 1).with("resumed", false),
    ev("published").with("gen", 1),
    ev("callstarted").with("origin", "call").with("call", 1).with("resendable", true).with("ckind", "open").with("fh", 1),
    ev("callready").with("origin", "call").with("call", 1).with("gen", 1),
    ev("stream").with("origin", "call").with("call", 1).with("gen", 1).with("stream", 4),
    ev("decoded").with("gen", 1).with("stream", 4).with("change", true).with("held", false),
    ev("began").with("gen", 1).with("stream", 4).with("begun", "running").with("counts", true).with("epoch", 1).with("running", 1).with("abandoned", 0).with("older", 0),
    ev("reserved").with("session", 1).with("fh", 1).with("kept", false),
    ev("finished").with("gen", 1).with("stream", 4).with("errno", false).with("counts", true).with("epoch", 1).with("running", 0).with("abandoned", 0).with("older", 0),
    ev("answered").with("origin", "call").with("call", 1).with("gen", 1).with("stream", 4).with("errno", false),
    ev("callstarted").with("origin", "call").with("call", 2).with("resendable", true).with("ckind", "change"),
    ev("callready").with("origin", "call").with("call", 2).with("gen", 1),
    ev("stream").with("origin", "call").with("call", 2).with("gen", 1).with("stream", 8),
    ev("decoded").with("gen", 1).with("stream", 8).with("change", true).with("held", false),
    ev("began").with("gen", 1).with("stream", 8).with("begun", "running").with("counts", true).with("epoch", 1).with("running", 1).with("abandoned", 0).with("older", 0),
    ev("failed").with("origin", "call").with("call", 2).with("gen", 1).with("stream", 8).with("failure", "lost"),
    ev("connlost").with("gen", 1),
    ev("connended").with("gen", 1),
    ev("resumed").with("session", 1).with("dropped", false).with("counts", true).with("epoch", 2).with("running", 0).with("abandoned", 0).with("older", 1),
    ev("attached").with("session", 1).with("epoch", 2).with("gen", 2),
    ev("connected").with("gen", 2).with("session", 1).with("resumed", true),
    ev("published").with("gen", 2),
    ev("callready").with("origin", "call").with("call", 2).with("gen", 2),
    ev("finished").with("gen", 1).with("stream", 8).with("errno", false).with("counts", true).with("epoch", 2).with("running", 0).with("abandoned", 0).with("older", 0),
    ev("stream").with("origin", "call").with("call", 2).with("gen", 2).with("stream", 4),
    ev("decoded").with("gen", 2).with("stream", 4).with("change", true).with("held", false),
    ev("began").with("gen", 2).with("stream", 4).with("begun", "running").with("counts", true).with("epoch", 2).with("running", 1).with("abandoned", 0).with("older", 0),
    ev("finished").with("gen", 2).with("stream", 4).with("errno", false).with("counts", true).with("epoch", 2).with("running", 0).with("abandoned", 0).with("older", 0),
    ev("answered").with("origin", "call").with("call", 2).with("gen", 2).with("stream", 4).with("errno", false),
    ev("callstarted").with("origin", "call").with("call", 3).with("resendable", true).with("ckind", "change"),
    ev("callready").with("origin", "call").with("call", 3).with("gen", 2),
    ev("stream").with("origin", "call").with("call", 3).with("gen", 2).with("stream", 8),
    ev("failed").with("origin", "call").with("call", 3).with("gen", 2).with("stream", 8).with("failure", "notsent"),
    ev("decoded").with("gen", 2).with("stream", 8).with("change", true).with("held", false),
    ev("began").with("gen", 2).with("stream", 8).with("begun", "running").with("counts", true).with("epoch", 2).with("running", 1).with("abandoned", 0).with("older", 0),
    ev("finished").with("gen", 2).with("stream", 8).with("errno", false).with("counts", true).with("epoch", 2).with("running", 0).with("abandoned", 0).with("older", 0),
    ev("answered").with("origin", "call").with("call", 3).with("gen", 2).with("stream", 8).with("errno", false),
    ev("callstarted").with("origin", "call").with("call", 4).with("resendable", true).with("ckind", "release").with("fh", 1).with("ordered", false),
